# Copy to .env.local for development. In production set these in Vercel →
# Settings → Environment Variables. Never commit real values.

# AI strategy reader (typed strategies and YouTube videos)
ANTHROPIC_API_KEY=

# Database (Vercel → Storage → Neon sets this). Without it, `next dev` uses a
# local PGlite database in ./.data and production has no database.
DATABASE_URL=

# Admin sign-in at /admin/login
ADMIN_PASSWORD=
# Optional: separate key for signing admin sessions (defaults to ADMIN_PASSWORD)
ADMIN_SESSION_SECRET=

# PayHero / FinoQ M-Pesa payments
PAYHERO_BASIC_AUTH=
PAYHERO_CHANNEL_ID=
PAYHERO_CALLBACK_SECRET=
# Optional overrides
# PAYHERO_API_BASE=https://backend.payhero.co.ke
# PAYHERO_CALLBACK_BASE=https://www.stratobot.trade
